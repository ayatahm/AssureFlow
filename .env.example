# Copy to .env and adjust. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# local-synthetic | shared | production
ASSUREFLOW_PROFILE=local-synthetic
# EMAIL_CODE_REQUIRED (default) | PASSWORD_ONLY_LOCAL (local synthetic development only)
AUTH_FLOW_STAGE=EMAIL_CODE_REQUIRED
ASSUREFLOW_RELEASE=False

DB_ENGINE=postgresql
DB_NAME=assureflow
DB_USER=assureflow
DB_PASSWORD=assureflow
DB_HOST=127.0.0.1
DB_PORT=5432

EVIDENCE_ROOT=./evidence

# Development: console | file. Production: smtp via approved relay only.
EMAIL_MODE=console
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=assureflow@localhost
